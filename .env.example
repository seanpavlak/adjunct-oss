# Canvas auth via 1Password CLI (required)
# Login item must include username, password, and a one-time password field.
# Requires `op` CLI + `op signin` (or 1Password app integration).
CANVAS_OP_ITEM=your-1password-item-uuid-or-name
# CANVAS_OP_VAULT=Personal

# LLM API Keys (at least one required)
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
